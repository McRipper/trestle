source 'https://rubygems.org'
require 'pathname'

default_root = File.expand_path('..', __dir__)
default_root = File.dirname(default_root) if File.file?(File.join(default_root, 'trestle.gemspec'))
workspace_root = ENV.fetch('TRESTLE_WORKSPACE', default_root)
repo_path = ->(name) { Pathname.new(File.join(workspace_root, name)).relative_path_from(Pathname.new(__dir__)).to_s }

gem 'rails', '~> 8.1.0'
gem 'sprockets-rails', require: ENV.fetch('ASSET_PIPELINE', 'sprockets-rails') == 'sprockets-rails' ? 'sprockets/railtie' : false
gem 'propshaft', require: ENV['ASSET_PIPELINE'] == 'propshaft'
gem 'sqlite3', '>= 2.1'
gem 'pg'
gem 'good_job', '~> 4.0'
gem 'mobility', '~> 1.0'

gem 'trestle', path: repo_path.call('trestle')
%w[trestle-auth trestle-auth-otp trestle-search trestle-active_storage trestle-good_job trestle-mobility].each do |name|
  path = name == 'trestle-auth-otp' ? ENV.fetch('TRESTLE_OTP_PATH', repo_path.call(name)) : repo_path.call(name)
  gem name, path: path, require: ENV['TRESTLE_TEST_GEM'] == name ? name.tr('-', '/') : false
end

group :test do
  gem 'rspec-rails', '~> 8.1'
  gem 'rspec-html-matchers', '~> 0.10.0'
  gem 'ammeter', '~> 1.1.7'
  gem 'coveralls_reborn', require: false
  gem 'capybara'
  gem 'selenium-webdriver'
  gem 'puma'
  gem 'capybara-screenshot'
  gem 'launchy'
  gem 'show_me_the_cookies', '~> 6.0'
  gem 'timecop', '~> 0.9'
  gem 'devise'
  gem 'haml', '~> 6.0'
  gem 'faker'
  gem 'minitest', '~> 5.0'
  gem 'image_processing', '~> 1.14', require: false
end
